<?xml version="1.0"?>
<!-- 固定 RGB 相机，看向白板。spawn 位姿由 launch 用 scene.yaml 的 camera 段给定，
     并与 launch 里的 static TF (world->board_camera_link) 保持一致。
     发布 /board_camera/image_raw 与 /board_camera/camera_info。 -->
<sdf version="1.6">
  <model name="board_camera">
    <static>true</static>
    <link name="board_camera_link">
      <visual name="cam_body">
        <geometry><box><size>0.03 0.06 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.4 1</ambient><diffuse>0.1 0.1 0.6 1</diffuse></material>
      </visual>
      <sensor name="board_camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>true</visualize>
        <camera name="board_camera">
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="board_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>board_camera</namespace>
          </ros>
          <camera_name>board_camera</camera_name>
          <frame_name>board_camera_optical</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
